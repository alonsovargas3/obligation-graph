ANTHROPIC_API_KEY=
OG_EXTRACT_MODEL=claude-sonnet-5-5
OG_GATE_MODEL=claude-haiku-4-5-20251001
OG_JEV_ENABLED=false
# EDGAR requires a descriptive User-Agent with a contact email
OG_EDGAR_USER_AGENT="obligation-graph research you@example.com"
OG_EXTRACT_EFFORT=high
OG_EXTRACT_CHUNK_CHARS=12000
# The API key is never stored here; load it per process, e.g.
# ANTHROPIC_API_KEY="$(cat ~/.config/og/anthropic.key)" make extract
